{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Ve\u00edculo de interesse"
    },
    "vehicle_label": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do ve\u00edculo no momento do contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "done"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green"
      ],
      "default": "new"
    },
    "internal_notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es do atendimento"
    }
  },
  "required": [
    "name",
    "phone",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}