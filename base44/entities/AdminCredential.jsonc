{
  "name": "AdminCredential",
  "type": "object",
  "description": "Senha compartilhada do painel administrativo (hash PBKDF2). Acesso apenas via fun\u00e7\u00f5es de servidor.",
  "properties": {
    "password_hash": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "iterations": {
      "type": "number"
    },
    "failed_attempts": {
      "type": "number"
    },
    "locked_until": {
      "type": "string"
    },
    "password_updated_at": {
      "type": "string"
    }
  },
  "required": [
    "password_hash",
    "salt"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}