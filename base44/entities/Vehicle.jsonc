{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "description": "Marca do ve\u00edculo"
    },
    "model": {
      "type": "string",
      "description": "Modelo do ve\u00edculo"
    },
    "version": {
      "type": "string",
      "description": "Vers\u00e3o / motoriza\u00e7\u00e3o comercial"
    },
    "year_manufacture": {
      "type": "number",
      "description": "Ano de fabrica\u00e7\u00e3o"
    },
    "year_model": {
      "type": "number",
      "description": "Ano do modelo"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda em reais"
    },
    "mileage": {
      "type": "number",
      "description": "Quilometragem"
    },
    "fuel": {
      "type": "string",
      "enum": [
        "Flex",
        "Gasolina",
        "\u00c1lcool",
        "Diesel",
        "H\u00edbrido",
        "El\u00e9trico"
      ],
      "enumColors": [
        "blue",
        "gray",
        "purple",
        "yellow",
        "green",
        "green"
      ]
    },
    "transmission": {
      "type": "string",
      "enum": [
        "Manual",
        "Autom\u00e1tico",
        "Automatizado",
        "CVT"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green"
      ]
    },
    "color": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Seminovo",
        "Novo",
        "Consignado",
        "Moto"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow"
      ]
    },
    "body_type": {
      "type": "string",
      "enum": [
        "Hatch",
        "Sedan",
        "SUV",
        "Picape",
        "Utilit\u00e1rio",
        "Moto",
        "Outro"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "gray",
        "pink",
        "gray"
      ]
    },
    "doors": {
      "type": "number"
    },
    "engine": {
      "type": "string",
      "description": "Motoriza\u00e7\u00e3o (ex: 1.3 T270)"
    },
    "power": {
      "type": "string",
      "description": "Pot\u00eancia (ex: 185 cv)"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Opcionais"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Equipamentos"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas do an\u00fancio"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "paused",
        "sold"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "available"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos do ve\u00edculo; a primeira \u00e9 a principal"
    }
  },
  "required": [
    "brand",
    "model",
    "price",
    "year_model",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}